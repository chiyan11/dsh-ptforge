              <TEXT>var serverIP = "11.0.0.1";
var serverPort = 5679;
var client;

function main() {
	client = new TCPClient();
	client.onConnectionChanged = function(type) {
		Device.println("connection changed: " + type);
	};
	
	client.onData = function(data) {
		Device.println("My IP: " + client.localIP() + ":" + client.localPort());
		Device.println("Server IP: "  + client.remoteIP() + ":" + client.remotePort());
		Device.println("received from server: " + data);
		client.send("I'm client1");
	};
	
	// connect to server
	client.connect(serverIP, serverPort);
}
