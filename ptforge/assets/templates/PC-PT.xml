#
function check_if_fakeroot() {
	echo -n "Check: Running under fakeroot?"
	[ -z "${FAKEROOTKEY}" ] &amp;&amp; echo "no" &amp;&amp; exit 1;
	echo yes, FAKEROOTKEY: $FAKEROOTKEY
}
function copy_new_app() {
	cp ./server.bin $1/usr/bin/
	echo -n "tcpClient1 &amp;" &gt;&gt; $1/etc/rc.d/rc.local
}
#
# Main function
#
function main() {
	check_if_fakeroot
	copy_new_app $1
	exit 0;
}

