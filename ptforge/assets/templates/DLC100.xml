function validateLogin(form)
{
  var userid = document.forms["login"]["userid"].value;
  var password = document.forms["login"]["pw"].value;
  if (userid.length == 0)
  {
    alert("Please enter the userid.");
  }
  else if (password.length == 0)
  {
    alert("Please enter the password.");
  }
  else
  {
    CHttpFormExtractor.submitIoeLogin(userid, password, function(rtn) {form.submit();});
  }
  return false;
}
