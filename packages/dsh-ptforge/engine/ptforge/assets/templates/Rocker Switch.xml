              <TEXT>from gpio import *
from time import *
from physical import *

is_open = False
P1 = 0
PImage = 1

def main():
    global is_open
    update(is_open)
    while True:
    	delay(1000)


def mouseEvent(pressed, x, y, firstPress):
    global is_open
    # if mouse is first pressed, then flip it
    if firstPress == True:
        update(not is_open)

def update(open):
    global is_open
    global PImage
    global P1
    is_open = open
    if is_open == True:
        digitalWrite(PImage, HIGH)
    else:
        digitalWrite(PImage, LOW)

    if is_open == True:
        digitalWrite(P1, HIGH)
    else:
        digitalWrite(P1, LOW)
        
    setDeviceProperty(getName(), "state", is_open)
    
if __name__ == "__main__":
	main()

