              <TEXT>var is_open = false; 
var P1 = 0;
var PImage = 1;

function setup() {
    update(is_open);
}

function mouseEvent(pressed, x, y, firstPress) {
	// if mouse is first pressed, then flip it
	if (firstPress)
		update(!is_open);
}

function update(open){
	is_open = open;
	
   	digitalWrite(PImage, is_open ? HIGH : LOW);
   	digitalWrite(P1, is_open ? HIGH : LOW);
   	
   	setDeviceProperty(getName(), "state", is_open);
}
